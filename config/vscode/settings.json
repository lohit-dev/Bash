{
  "editor.fontFamily": "Dank Mono",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.fontSize": 17,
  "editor.lineNumbers": "relative",
  "explorer.confirmDragAndDrop": false,
  "editor.wordWrap": "on",
  "explorer.confirmDelete": false,
  "reactSnippets.settings.importReactOnTop": false,
  "editor.cursorBlinking": "blink",
  "editor.cursorStyle": "block-outline",
  "editor.find.cursorMoveOnType": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "emmet.includeLanguages": { "javascript": "javascriptreact" },
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindings": [{ "before": ["j", "j"], "after": ["<Esc>"] }],
  "vim.normalModeKeyBindingsNonRecursive": [{ "before": ["<C-n>"], "commands": [":nohl"] }],
  "vim.leader": "<space>",
  "vim.handleKeys": { "<C-a>": false, "<C-f>": false },
  "extensions.experimental.affinity": { "vscodevim.vim": 1 },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "git.openRepositoryInParentFolders": "never",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.accessibilitySupport": "off",
  "terminal.integrated.env.windows": {},
  "git.autofetch": true,
  "workbench.statusBar.visible": true,
  "window.menuBarVisibility": "compact",
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "window.zoomLevel": 0,
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "top",
  "redhat.telemetry.enabled": true,
  "git.confirmSync": false,
  "workbench.colorTheme": "Andromeda Italic",
  "workbench.iconTheme": "material-icon-theme",
  "cSpell.userWords": ["nums"],
  "[java]": { "editor.defaultFormatter": "redhat.java" },
  "git.enableSmartCommit": true
}
